{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# This Python 3 environment comes with many helpful analytics libraries installed\n# It is defined by the kaggle/python Docker image: https://github.com/kaggle/docker-python\n# For example, here's several helpful packages to load\n\nimport numpy as np # linear algebra\nimport pandas as pd # data processing, CSV file I/O (e.g. pd.read_csv)\n\n# Input data files are available in the read-only \"../input/\" directory\n# For example, running this (by clicking run or pressing Shift+Enter) will list all files under the input directory\n\nimport os\nfor dirname, _, filenames in os.walk('/kaggle/input'):\n    for filename in filenames:\n        print(os.path.join(dirname, filename))\n\n# You can write up to 20GB to the current directory (/kaggle/working/) that gets preserved as output when you create a version using \"Save & Run All\" \n# You can also write temporary files to /kaggle/temp/, but they won't be saved outside of the current session\n\n# Use the kagglehub client library to attach Kaggle resources like competitions, datasets, and models to your session\n# Learn more about kagglehub: https://github.com/Kaggle/kagglehub/blob/main/README.md\n\nimport kagglehub\n# kagglehub.dataset_download('<owner>/<dataset-slug>')","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-10-29T23:19:04.011514Z","iopub.execute_input":"2026-10-29T23:19:04.011828Z","iopub.status.idle":"2026-10-29T23:19:06.866867Z","shell.execute_reply.started":"2026-10-29T23:19:04.011792Z","shell.execute_reply":"2026-10-29T23:19:06.865959Z"}},"outputs":[],"execution_count":1},{"cell_type":"code","source":"\"\"\"\nASAMA 1 SIMULASYONU\nHucresiz ISAC + coklu AP + sensing destekli fiziksel katman kimlik dogrulama (PLA)\n\nNe yapar?\n  - 4 erisim noktasi (AP) bir alanin kose noktalarina yerlesir.\n  - Hareket eden bir meşru kullanici (UE) vardir. Her AP onun menzilini, geliş açısını\n    ve radyal hizini (Doppler) gurultulu olarak olcer.\n  - Saldirilar:\n      A1: Taklitci. Baska bir konumdan UE gibi davranir.\n      A3: Hayalet hedef (replay). Saldirgan tek bir AP'nin menzil ve Doppler olcumunu kaydirir.\n      A4: Koordineli sahtecilik. Saldirgan TUM AP'lere tutarli sahte bir konum gosterir.\n  - Iki test:\n      TUTARLILIK testi: AP'lerin olcumleri birbiriyle uyumlu mu? (ki-kare artik testi)\n      KAPI testi: Olcumlerden bulunan konum/hiz, onceden bilinen (tahmin edilen) konum/hizla uyumlu mu?\n  - Karsilastirma: tek AP (sadece menzil + aci ile konum) ve coklu AP.\n  - Cikti: 4 grafik (sonuclar.png) ve ekrana yazilan sayilar.\n\nCalistirmak icin:  python asama1_simulasyon.py\nGerekli paketler:  numpy, scipy, matplotlib\n\"\"\"\n\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.stats import chi2\n\nrng = np.random.default_rng(42)  # sabit tohum: her calistirmada ayni sonuc\n\n# =====================================================================\n# 1. PARAMETRELER (istersen burayi degistirip deney yapabilirsin)\n# =====================================================================\nALAN = 200.0                                   # alan: 200 m x 200 m\nAP_POZ = np.array([[0, 0], [ALAN, 0], [ALAN, ALAN], [0, ALAN]], dtype=float)\nL = len(AP_POZ)                                # AP sayisi\n\nSIG_R = 1.0                                    # menzil olcum hatasi [m]\nSIG_TH = np.deg2rad(1.0)                       # aci olcum hatasi [rad]\nSIG_D = 0.5                                    # radyal hiz olcum hatasi [m/s]\nSIGMA = np.array([SIG_R, SIG_TH, SIG_D])\n\nHIZ = 10.0                                     # kullanici hizi [m/s] (~36 km/h)\n\nSIG_POZ_TAHMIN = 3.0                           # onceden bilinen konumun belirsizligi [m]\nSIG_HIZ_TAHMIN = 0.5                           # onceden bilinen hizin belirsizligi [m/s]\nP_PRED = np.diag([SIG_POZ_TAHMIN**2] * 2 + [SIG_HIZ_TAHMIN**2] * 2)\n\nN_ROC = 4000                                   # ROC icin deneme sayisi\nN_SWEEP = 1500                                 # saldiri siddeti taramasi icin deneme sayisi\nN_ID = 600                                     # AP tanima taramasi icin deneme sayisi\nTUM = np.arange(L)\n\n\n# =====================================================================\n# 2. OLCUM MODELI\n# =====================================================================\ndef olcum_uret(p, v):\n    \"\"\"Gurultusuz olcumler. Her AP icin [menzil, aci, radyal hiz].\"\"\"\n    d = p - AP_POZ\n    rho = np.linalg.norm(d, axis=1)\n    u = d / rho[:, None]                       # AP'den UE'ye birim vektor\n    aci = np.arctan2(d[:, 1], d[:, 0])\n    rad = u @ v                                # Doppler ~ v . u / lambda\n    return np.stack([rho, aci, rad], axis=1)\n\n\ndef gurultu_ekle(z):\n    n = np.stack([rng.normal(0, SIG_R, len(z)),\n                  rng.normal(0, SIG_TH, len(z)),\n                  rng.normal(0, SIG_D, len(z))], axis=1)\n    return z + n\n\n\n# =====================================================================\n# 3. KONUM + HIZ KESTIRIMI (Gauss-Newton, agirlikli en kucuk kareler)\n#    Bilinmeyenler: x = [px, py, vx, vy]\n# =====================================================================\ndef _lineer(x, z, ap):\n    p, v = x[:2], x[2:]\n    d = p - ap\n    rho = np.linalg.norm(d, axis=1)\n    u = d / rho[:, None]\n    h = np.stack([rho, np.arctan2(d[:, 1], d[:, 0]), u @ v], axis=1)\n    r = z - h\n    r[:, 1] = (r[:, 1] + np.pi) % (2 * np.pi) - np.pi     # acıyı [-pi, pi] aralığına sar\n    m = len(ap)\n    J = np.zeros((3 * m, 4))\n    res = np.zeros(3 * m)\n    W = np.zeros(3 * m)\n    for k in range(m):\n        uk, rk = u[k], rho[k]\n        J[3 * k, :2] = uk                                           # menzil turevi\n        J[3 * k + 1, :2] = [-d[k, 1] / rk**2, d[k, 0] / rk**2]      # aci turevi\n        J[3 * k + 2, :2] = (v - (v @ uk) * uk) / rk                 # radyal hiz / konum\n        J[3 * k + 2, 2:] = uk                                       # radyal hiz / hiz\n        res[3 * k:3 * k + 3] = r[k]\n        W[3 * k:3 * k + 3] = 1.0 / SIGMA**2\n    return J, res, W\n\n\ndef cozum(z, ap_idx):\n    \"\"\"z: secilen AP'lerin olcumleri, ap_idx: bu AP'lerin numaralari.\n    Donus: x_hat (4,), kovaryans (4x4), T (tutarlilik istatistigi).\"\"\"\n    ap = AP_POZ[ap_idx]\n    # baslangic: her AP'nin (menzil, aci)'dan buldugu konumun medyani\n    p_ap = ap + z[:, [0]] * np.stack([np.cos(z[:, 1]), np.sin(z[:, 1])], axis=1)\n    p0 = np.median(p_ap, axis=0)\n    d = p0 - ap\n    u = d / np.linalg.norm(d, axis=1)[:, None]\n    v0 = np.linalg.lstsq(u, z[:, 2], rcond=None)[0]\n    x = np.concatenate([p0, v0])\n    for _ in range(15):\n        J, res, W = _lineer(x, z, ap)\n        A = J.T @ (J * W[:, None])\n        dx = np.linalg.solve(A, J.T @ (W * res))\n        x = x + dx\n        if np.linalg.norm(dx) < 1e-6:\n            break\n    J, res, W = _lineer(x, z, ap)\n    A = J.T @ (J * W[:, None])\n    cov = np.linalg.inv(A)\n    T = float(np.sum(W * res**2))              # H0 altinda ~ ki-kare(3m - 4)\n    return x, cov, T\n\n\n# =====================================================================\n# 4. TEST ISTATISTIKLERI\n# =====================================================================\ndef kapi_skoru(x_hat, cov, x_pred):\n    \"\"\"Coklu AP kapi testi: kestirim ile onceden bilinen konum+hiz arasi Mahalanobis uzakligi.\"\"\"\n    e = x_hat - x_pred\n    return float(e @ np.linalg.solve(cov + P_PRED, e))\n\n\ndef tek_ap_skoru(z0, ap_i, p_pred):\n    \"\"\"Tek AP: sadece (menzil, aci) ile konum bulunur, hiz vektoru bulunamaz.\"\"\"\n    r, th = z0[0], z0[1]\n    p_hat = AP_POZ[ap_i] + r * np.array([np.cos(th), np.sin(th)])\n    R = np.array([[np.cos(th), -np.sin(th)], [np.sin(th), np.cos(th)]])\n    C = R @ np.diag([SIG_R**2, (r * SIG_TH) ** 2]) @ R.T\n    e = p_hat - p_pred\n    return float(e @ np.linalg.solve(C + SIG_POZ_TAHMIN**2 * np.eye(2), e))\n\n\n# =====================================================================\n# 5. SENARYOLAR\n# =====================================================================\ndef rastgele_ue():\n    p = rng.uniform(40, ALAN - 40, 2)\n    a = rng.uniform(0, 2 * np.pi)\n    return p, HIZ * np.array([np.cos(a), np.sin(a)])\n\n\ndef tahmin(p, v):\n    \"\"\"Dogrulayicinin elindeki onceden bilinen konum/hiz (ust katman veya izleme).\"\"\"\n    return np.concatenate([p + rng.normal(0, SIG_POZ_TAHMIN, 2),\n                           v + rng.normal(0, SIG_HIZ_TAHMIN, 2)])\n\n\ndef olcumler(durum, p, v, delta=0.0, k=0):\n    \"\"\"durum: 'H0' (mesru), 'A1' (taklit, delta=uzaklik), 'A3' (hayalet, delta=menzil kaymasi),\n    'A4' (koordineli, delta=gorunen konum kaymasi).\"\"\"\n    if durum == \"H0\":\n        return gurultu_ekle(olcum_uret(p, v))\n    if durum == \"A1\":\n        ph = rng.uniform(0, 2 * np.pi)\n        p_a = np.clip(p + delta * np.array([np.cos(ph), np.sin(ph)]), 0, ALAN)\n        ha = rng.uniform(0, 2 * np.pi)\n        v_a = HIZ * np.array([np.cos(ha), np.sin(ha)])\n        return gurultu_ekle(olcum_uret(p_a, v_a))\n    if durum == \"A3\":\n        z = gurultu_ekle(olcum_uret(p, v))\n        s = rng.choice([-1.0, 1.0])\n        z[k, 0] += s * delta                   # replay: gecikme -> menzil kaymasi\n        z[k, 2] += s * 0.1 * delta             # replay: frekans kaymasi -> Doppler kaymasi\n        return z\n    if durum == \"A4\":\n        ph = rng.uniform(0, 2 * np.pi)\n        p_f = p + delta * np.array([np.cos(ph), np.sin(ph)])\n        return gurultu_ekle(olcum_uret(p_f, v))     # tum AP'lere tutarli sahte konum\n    raise ValueError(durum)\n\n\ndef skorlar(durum, delta=0.0, k=0):\n    p, v = rastgele_ue()\n    x_pred = tahmin(p, v)\n    z = olcumler(durum, p, v, delta, k)\n    x_hat, cov, T = cozum(z, TUM)\n    G = kapi_skoru(x_hat, cov, x_pred)\n    Gs = tek_ap_skoru(z[0], 0, x_pred[:2])\n    return T, G, Gs\n\n\ndef en_supheli_ap(z):\n    \"\"\"Her seferinde bir AP'yi disarida birakip testi tekrarlar.\n    Tutarlilik istatistigi en cok dusen AP en supheli AP'dir.\"\"\"\n    Ts = []\n    for l in range(L):\n        alt = np.delete(TUM, l)\n        _, _, T = cozum(z[alt], alt)\n        Ts.append(T)\n    return int(np.argmin(Ts))\n\n\ndef roc(h0, h1, pfa):\n    esik = np.quantile(h0, 1 - pfa)\n    return np.array([(h1 > e).mean() for e in esik])\n\n\ndef pd_at(h0, h1, pfa=0.01):\n    return float((h1 > np.quantile(h0, 1 - pfa)).mean())\n\n\n# =====================================================================\n# 6. ANA PROGRAM\n# =====================================================================\nif __name__ == \"__main__\":\n    print(\"=== ASAMA 1 SIMULASYONU BASLADI (birkac dakika surebilir) ===\")\n\n    # --- 6.1 Mesru kullanici (H0) ---\n    print(\"[1/5] Mesru kullanici (H0) simule ediliyor...\")\n    H0 = np.array([skorlar(\"H0\") for _ in range(N_ROC)])\n    T0, G0, Gs0 = H0[:, 0], H0[:, 1], H0[:, 2]\n    esik_teorik = chi2.ppf(0.99, 3 * L - 4)\n    print(f\"  SAGLAMA: T ortalamasi = {T0.mean():.2f} (beklenen ~{3 * L - 4})\")\n    print(f\"  SAGLAMA: teorik esikle yanlis alarm = {(T0 > esik_teorik).mean():.4f} (beklenen ~0.01)\")\n\n    # --- 6.2 A1 taklitci ---\n    print(\"[2/5] A1 taklitci saldirisi...\")\n    A1 = np.array([skorlar(\"A1\", delta=rng.uniform(10, 100)) for _ in range(N_ROC)])\n    G1, Gs1 = A1[:, 1], A1[:, 2]\n\n    # --- 6.3 A3 hayalet hedef (delta = 10 m) ---\n    print(\"[3/5] A3 hayalet hedef saldirisi (10 m kayma)...\")\n    A3m = np.array([skorlar(\"A3\", delta=10.0, k=int(rng.integers(L))) for _ in range(N_ROC)])\n    A3s = np.array([skorlar(\"A3\", delta=10.0, k=0) for _ in range(N_ROC)])\n    T3, G3 = A3m[:, 0], A3m[:, 1]\n    Gs3 = A3s[:, 2]\n\n    pfa = np.logspace(-3, 0, 60)\n\n    # --- 6.4 Saldiri siddeti taramasi ---\n    print(\"[4/5] Saldiri siddeti taramasi...\")\n    deltalar = np.array([0, 2, 4, 6, 8, 10, 15, 20, 30], dtype=float)\n    pd_T3, pd_G3, pd_Gs3, pd_T4, pd_G4 = [], [], [], [], []\n    for dl in deltalar:\n        a3m = np.array([skorlar(\"A3\", dl, int(rng.integers(L))) for _ in range(N_SWEEP)])\n        a3s = np.array([skorlar(\"A3\", dl, 0) for _ in range(N_SWEEP)])\n        a4 = np.array([skorlar(\"A4\", dl) for _ in range(N_SWEEP)])\n        pd_T3.append(pd_at(T0, a3m[:, 0]))\n        pd_G3.append(pd_at(G0, a3m[:, 1]))\n        pd_Gs3.append(pd_at(Gs0, a3s[:, 2]))\n        pd_T4.append(pd_at(T0, a4[:, 0]))\n        pd_G4.append(pd_at(G0, a4[:, 1]))\n        print(f\"  delta={dl:5.1f} m  A3: tutarlilik={pd_T3[-1]:.2f} kapi(coklu)={pd_G3[-1]:.2f} \"\n              f\"kapi(tek)={pd_Gs3[-1]:.2f} | A4: tutarlilik={pd_T4[-1]:.2f} kapi(coklu)={pd_G4[-1]:.2f}\")\n\n    # --- 6.5 Saldirgan AP'yi tanima ---\n    print(\"[5/5] Saldirgan AP tanima (birini disarida birak)...\")\n    id_dogruluk = []\n    for dl in deltalar[1:]:\n        dogru = 0\n        for _ in range(N_ID):\n            p, v = rastgele_ue()\n            k = int(rng.integers(L))\n            z = olcumler(\"A3\", p, v, dl, k)\n            dogru += (en_supheli_ap(z) == k)\n        id_dogruluk.append(dogru / N_ID)\n        print(f\"  delta={dl:5.1f} m  dogru AP tanima orani = {id_dogruluk[-1]:.2f}\")\n\n    # =================================================================\n    # GRAFIKLER\n    # =================================================================\n    fig, ax = plt.subplots(2, 2, figsize=(12, 9))\n\n    # (a) A1 ROC\n    a = ax[0, 0]\n    a.semilogx(pfa, roc(G0, G1, pfa), label=f\"Coklu AP ({L} AP), kapi testi\", lw=2)\n    a.semilogx(pfa, roc(Gs0, Gs1, pfa), label=\"Tek AP, kapi testi\", lw=2, ls=\"--\")\n    a.set_xlabel(\"Yanlis alarm olasiligi (Pfa)\")\n    a.set_ylabel(\"Tespit olasiligi (Pd)\")\n    a.set_title(\"(a) Taklitci saldirisi A1 (uzaklik 10-100 m)\")\n    a.grid(True, which=\"both\", alpha=0.3)\n    a.legend()\n\n    # (b) A3 ROC\n    a = ax[0, 1]\n    a.semilogx(pfa, roc(T0, T3, pfa), label=\"Coklu AP, tutarlilik testi\", lw=2)\n    a.semilogx(pfa, roc(G0, G3, pfa), label=\"Coklu AP, kapi testi\", lw=2)\n    a.semilogx(pfa, roc(Gs0, Gs3, pfa), label=\"Tek AP, kapi testi\", lw=2, ls=\"--\")\n    a.set_xlabel(\"Yanlis alarm olasiligi (Pfa)\")\n    a.set_ylabel(\"Tespit olasiligi (Pd)\")\n    a.set_title(\"(b) Hayalet hedef A3 (10 m kayma, 1 AP)\")\n    a.grid(True, which=\"both\", alpha=0.3)\n    a.legend()\n\n    # (c) Pd - saldiri siddeti\n    a = ax[1, 0]\n    a.plot(deltalar, pd_T3, \"o-\", label=\"A3 tutarlilik (coklu)\")\n    a.plot(deltalar, pd_G3, \"s-\", label=\"A3 kapi (coklu)\")\n    a.plot(deltalar, pd_Gs3, \"^--\", label=\"A3 kapi (tek AP)\")\n    a.plot(deltalar, pd_T4, \"x:\", label=\"A4 tutarlilik (coklu)\")\n    a.plot(deltalar, pd_G4, \"d-\", label=\"A4 kapi (coklu)\")\n    a.set_xlabel(\"Saldiri siddeti delta [m]\")\n    a.set_ylabel(\"Pd (Pfa = 0.01)\")\n    a.set_title(\"(c) Saldiri siddetine gore tespit\")\n    a.grid(True, alpha=0.3)\n    a.legend(fontsize=8)\n\n    # (d) AP tanima\n    a = ax[1, 1]\n    a.plot(deltalar[1:], id_dogruluk, \"o-\", lw=2)\n    a.axhline(1.0 / L, color=\"gray\", ls=\":\", label=f\"Rastgele tahmin (1/{L})\")\n    a.set_xlabel(\"Saldiri siddeti delta [m]\")\n    a.set_ylabel(\"Dogru AP tanima orani\")\n    a.set_title(\"(d) Saldirgan AP'yi bulma (birini disarida birak)\")\n    a.set_ylim(0, 1.05)\n    a.grid(True, alpha=0.3)\n    a.legend()\n\n    plt.tight_layout()\n    plt.savefig(\"sonuclar.png\", dpi=150)\n    print(\"\\nGrafik kaydedildi: sonuclar.png\")\n    plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-29T23:19:57.160271Z","iopub.execute_input":"2026-10-29T23:19:57.160507Z","iopub.status.idle":"2026-10-29T23:21:16.448661Z","shell.execute_reply.started":"2026-10-29T23:19:57.160487Z","shell.execute_reply":"2026-10-29T23:21:16.447908Z"}},"outputs":[{"name":"stdout","text":"=== ASAMA 1 SIMULASYONU BASLADI (birkac dakika surebilir) ===\n[1/5] Mesru kullanici (H0) simule ediliyor...\n  SAGLAMA: T ortalamasi = 8.05 (beklenen ~8)\n  SAGLAMA: teorik esikle yanlis alarm = 0.0075 (beklenen ~0.01)\n[2/5] A1 taklitci saldirisi...\n","output_type":"stream"},{"name":"stderr","text":"/tmp/ipykernel_49/1962544585.py:60: RuntimeWarning: invalid value encountered in divide\n  u = d / rho[:, None]                       # AP'den UE'ye birim vektor\n","output_type":"stream"},{"name":"stdout","text":"[3/5] A3 hayalet hedef saldirisi (10 m kayma)...\n[4/5] Saldiri siddeti taramasi...\n  delta=  0.0 m  A3: tutarlilik=0.02 kapi(coklu)=0.01 kapi(tek)=0.01 | A4: tutarlilik=0.01 kapi(coklu)=0.01\n  delta=  2.0 m  A3: tutarlilik=0.06 kapi(coklu)=0.01 kapi(tek)=0.01 | A4: tutarlilik=0.01 kapi(coklu)=0.01\n  delta=  4.0 m  A3: tutarlilik=0.36 kapi(coklu)=0.01 kapi(tek)=0.05 | A4: tutarlilik=0.01 kapi(coklu)=0.04\n  delta=  6.0 m  A3: tutarlilik=0.85 kapi(coklu)=0.02 kapi(tek)=0.14 | A4: tutarlilik=0.02 kapi(coklu)=0.11\n  delta=  8.0 m  A3: tutarlilik=0.99 kapi(coklu)=0.04 kapi(tek)=0.36 | A4: tutarlilik=0.02 kapi(coklu)=0.28\n  delta= 10.0 m  A3: tutarlilik=1.00 kapi(coklu)=0.08 kapi(tek)=0.57 | A4: tutarlilik=0.02 kapi(coklu)=0.50\n  delta= 15.0 m  A3: tutarlilik=1.00 kapi(coklu)=0.21 kapi(tek)=0.96 | A4: tutarlilik=0.02 kapi(coklu)=0.93\n  delta= 20.0 m  A3: tutarlilik=1.00 kapi(coklu)=0.45 kapi(tek)=1.00 | A4: tutarlilik=0.02 kapi(coklu)=1.00\n  delta= 30.0 m  A3: tutarlilik=1.00 kapi(coklu)=0.90 kapi(tek)=1.00 | A4: tutarlilik=0.02 kapi(coklu)=1.00\n[5/5] Saldirgan AP tanima (birini disarida birak)...\n  delta=  2.0 m  dogru AP tanima orani = 0.43\n  delta=  4.0 m  dogru AP tanima orani = 0.76\n  delta=  6.0 m  dogru AP tanima orani = 0.95\n  delta=  8.0 m  dogru AP tanima orani = 0.99\n  delta= 10.0 m  dogru AP tanima orani = 1.00\n  delta= 15.0 m  dogru AP tanima orani = 1.00\n  delta= 20.0 m  dogru AP tanima orani = 1.00\n  delta= 30.0 m  dogru AP tanima orani = 1.00\n\nGrafik kaydedildi: sonuclar.png\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x900 with 4 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":1}]}