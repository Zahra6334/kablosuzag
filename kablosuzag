{len(conditions)} koşul için {len(conditions) * N_PER_COND * 2} örnek üretimi başlıyor...\")\n","\n","for snr, atype, clut, ntgt in tqdm(conditions, desc=\"Koşul Matrisi İlerlemesi\"):\n","    for rep in range(N_PER_COND):\n","        split_name = get_split(rep)\n","        \n","        # 1. SALDIRI ÖRNEĞİ ÜRETİMİ (Label = 1)\n","        seed_att = hash((\"attack\", snr, atype, clut, ntgt, rep)) % (2**31)\n","        rdm_att, meta_att = simulate_scenario(\n","            snr_db=snr,\n","            attack_type=atype,\n","            n_real_targets=ntgt,\n","            clutter_level=clut,\n","            seed=seed_att\n","        )\n","        sid_att = f\"{atype}_snr{snr:+d}_cl{clut}_t{ntgt}_r{rep:03d}\"\n","        npy_rel_att = f\"attack/{sid_att}.npy\"\n","        \n","        meta_att[\"sample_id\"] = sid_att\n","        meta_att[\"split\"] = split_name\n","        meta_att[\"file_path\"] = npy_rel_att\n","        \n","        np.save(out_dir / npy_rel_att, rdm_att)\n","        with open(out_dir / \"attack\" / f\"{sid_att}.json\", \"w\", encoding=\"utf-8\") as f:\n","            json.dump(meta_att, f, indent=2)\n","        all_metadata_records.append(meta_att)\n","        \n","        # 2. GÜVENLİ ÖRNEK ÜRETİMİ (Label = 0 - Dengeli Eşleşme)\n","        seed_safe = hash((\"safe\", snr, atype, clut, ntgt, rep)) % (2**31)\n","        rdm_safe, meta_safe = simulate_scenario(\n","            snr_db=snr,\n","            attack_type=None,\n","            n_real_targets=ntgt,\n","            clutter_level=clut,\n","            seed=seed_safe\n","        )\n","        # Güvenli örnek ID'sinde hangi saldırı koşuluna eşlik ettiği belirtilir (çakışmayı önler)\n","        sid_safe = f\"safe_{atype}_snr{snr:+d}_cl{clut}_t{ntgt}_r{rep:03d}\"\n","        npy_rel_safe = f\"safe/{sid_safe}.npy\"\n","        \n","        meta_safe[\"sample_id\"] = sid_safe\n","        meta_safe[\"split\"] = split_name\n","        meta_safe[\"file_path\"] = npy_rel_safe\n","        \n","        np.save(out_dir / npy_rel_safe, rdm_safe)\n","        with open(out_dir / \"safe\" / f\"{sid_safe}.json\", \"w\", encoding=\"utf-8\") as f:\n","            json.dump(meta_safe, f, indent=2)\n","        all_metadata_records.append(meta_safe)\n","\n","# Tüm metadata kayıtlarını tek bir CSV dosyasında topla (HuggingFace uyumlu)\n","df_meta = pd.DataFrame(all_metadata_records)\n","# Sütun sırasını şemaya uygun düzenle\n","cols_order = [\n","    \"sample_id\", \"label\", \"split\", \"file_path\", \"snr_db\", \"attack_type\",\n","    \"n_real_targets\", \"n_fake_targets\", \"clutter_level\", \"spoofer_power\",\n","    \"real_range_m\", \"real_velocity_ms\", \"fake_delta_range_m\", \"fake_delta_vel_ms\",\n","    \"ofdm_subcarriers\", \"cyclic_prefix\", \"carrier_freq_ghz\", \"bandwidth_mhz\", \"seed\"\n","]\n","df_meta = df_meta[cols_order]\n","df_meta.to_csv(out_dir / \"metadata_all.csv\", index=False)\n","\n","print(f\"\\nÜretim Tamamlandı! Toplam {len(df_meta)} örnek diske yazıldı.\")\n","print(df_meta[\"split\"].value_counts())"]},{"cell_type":"code","execution_count":3,"id":"afa1daaa","metadata":{"execution":{"iopub.execute_input":"2026-11-22T00:36:32.405366Z","iopub.status.busy":"2026-11-22T00:36:32.404644Z","iopub.status.idle":"2026-11-22T00:38:18.868012Z","shell.execute_reply":"2026-11-22T00:38:18.867065Z"},"papermill":{"duration":106.469164,"end_time":"2026-11-22T00:38:18.870002+00:00","exception":false,"start_time":"2026-11-22T00:36:32.400838+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Kontrol edilen .npy dosyası: 25200 | Hata sayısı: 0\n"]},{"name":"stderr","output_type":"stream","text":["WARNING: All log messages before absl::InitializeLog() is called are written to STDERR\n","I0000 00:00:1795307824.720246      23 gpu_device.cc:2020] Created device /job:localhost/replica:0/task:0/device:GPU:0 with 13756 MB memory:  -> device: 0, name: Tesla T4, pci bus id: 0000:00:04.0, compute capability: 7.5\n","I0000 00:0