 | Saldırı Örneği: 180 | Pd = % 77.8\n","SNR = +20 dB | Saldırı Örneği: 180 | Pd = % 73.9\n","SNR = +25 dB | Saldırı Örneği: 180 | Pd = % 76.1\n"]}],"source":["import numpy as np\n","import pandas as pd\n","from pathlib import Path\n","import tensorflow as tf\n","from tensorflow.keras import layers, models\n","from tensorflow.keras.preprocessing.image import ImageDataGenerator\n","\n","# --- 1. ADIM 6.1: OTOMATİK VERİ DOĞRULAMA ---\n","def validate_dataset(root: str):\n","    root_path = Path(root)\n","    errors = []\n","    npy_files = list(root_path.rglob(\"*.npy\"))\n","    \n","    for npy in npy_files:\n","        j = npy.with_suffix(\".json\")\n","        if not j.exists():\n","            errors.append(f\"Eksik JSON: {npy}\")\n","            continue\n","        rdm = np.load(npy)\n","        if rdm.shape != (64, 64):\n","            errors.append(f\"Yanlış şekil: {npy} -> {rdm.shape}\")\n","        if rdm.dtype != np.float32:\n","            errors.append(f\"Yanlış dtype: {npy} -> {rdm.dtype}\")\n","        if not (np.isfinite(rdm).all() and 0.0 <= rdm.min() and rdm.max() <= 1.0):\n","            errors.append(f\"Normalize/NaN hatası: {npy} (min={rdm.min()}, max={rdm.max()})\")\n","            \n","    return len(npy_files), errors\n","\n","total_npy, errs = validate_dataset(\"dataset_v2\")\n","print(f\"Kontrol edilen .npy dosyası: {total_npy} | Hata sayısı: {len(errs)}\")\n","if errs:\n","    print(\"İlk 5 hata:\", errs[:5])\n","\n","# --- 2. VERİ YÜKLEME & ADIM 5 AUGMENTATION HAZIRLIĞI ---\n","df = pd.read_csv(\"dataset_v2/metadata_all.csv\")\n","base_dir = Path(\"dataset_v2\")\n","\n","def load_split_arrays(split_name: str):\n","    sub = df[df[\"split\"] == split_name]\n","    X = np.stack([np.load(base_dir / p) for p in sub[\"file_path\"]])[..., np.newaxis]\n","    y = sub[\"label\"].values.astype(np.float32)\n","    snr = sub[\"snr_db\"].values\n","    return X, y, snr, sub\n","\n","X_train, y_train, _, _ = load_split_arrays(\"train\")\n","X_test, y_test, snr_test, df_test = load_split_arrays(\"test\")\n","\n","# Fiziksel anlamlı augmentasyon (Flip YOK: Doppler yönü ve menzil fiziği korunur)\n","datagen = ImageDataGenerator(\n","    width_shift_range=0.05,   # ±%5 Doppler/hız kayması\n","    height_shift_range=0.05,  # ±%5 menzil kayması\n","    zoom_range=0.10           # %90-110 ölçek varyasyonu\n",")\n","\n","def augmented_generator(X, y, batch_size=32, noise_std=0.02):\n","    gen = datagen.flow(X, y, batch_size=batch_size, shuffle=True, seed=42)\n","    while True:\n","        bx, by = next(gen)\n","        if noise_std > 0:\n","            noisy = bx + np.random.normal(0.0, noise_std, size=bx.shape).astype(np.float32)\n","            bx = np.clip(noisy, 0.0, 1.0)\n","        yield bx, by\n","\n","# --- 3. HIZLI CNN MODELİ & ADIM 6.3 SNR BAZLI Pd DOĞRULAMASI ---\n","tf.keras.utils.set_random_seed(42)\n","\n","model = models.Sequential([\n","    layers.Input(shape=(64, 64, 1)),\n","    layers.Conv2D(16, (3, 3), activation=\"relu\", padding=\"same\"),\n","    layers.MaxPooling2D((2, 2)),\n","    layers.Conv2D(32, (3, 3), activation=\"relu\", padding=\"same\"),\n","    layers.MaxPooling2D((2, 2)),\n","    layers.Flatten(),\n","    layers.Dropout(0.5),\n","    layers.Dense(64, activation=\"relu\"),\n","    layers.Dense(1, activation=\"sigmoid\")\n","])\n","\n","model.compile(\n","    optimizer=tf.keras.optimizers.Adam(learning_rate=1e-3),\n","    loss=\"binary_crossentropy\",\n","    metrics=[\"accuracy\"]\n",")\n","\n","batch_size = 32\n","steps_per_epoch = max(1, len(X_train) // batch_size)\n","model.fit(\n","    augmented_generator(X_train, y_train, batch_size=batch_size),\n","    steps_per_epoch=steps_per_epoch,\n","    epochs=5,\n","    validation_data=(X_test, y_test),\n","    verbose=1\n",")\n","\n","preds = (model.predict(X_test, verbose=0).ravel() >= 0.5).astype(int)\n","print(\"\\n--- SNR Seviyelerine Göre Saptama Olasılığı (Pd) ---\")\n","for s in sorted(df_test[\"snr_db\"].unique()):\n","    mask = (snr_test == s) & (y_test == 1)\n","    pd_val = np.mean(preds[mask]) if mask.sum() > 0 else np.nan\n","    print(f\"SNR = {s:+3d} dB | Saldırı Örneği: {mask.sum():2d} | Pd = %{pd_val*100:5.1f}\")"]},{"cell_type":"code","execution_count":4,"id":"5746057c","metadata":{"execution":{"iopub.execute_input":"2026-11-22T00:38:18.940433Z","iopub.status.busy":"2026-11-22T00:38:18.939861Z","iopub.status.idle":"2026-11-22T01:01:55.712771Z","shell.execute_reply":"2026-11-22T01:01:55.712003Z"},"papermill":{"duration":1416.807755,"end_time":"2026-11-22T01:01:55.714495+00:00","exception":false,"start_time":"2026-11-22T00:38:18.90674+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[Parça 3] SNR=[20, 25] | 72 koşul | 7200 örnek üretiliyor...\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"95ab7f51ff454c618c1a5be6def876c6","version_major":2,"version_minor":0},"text/plain":["Parça 3 İlerlemesi:   0%|          | 0/72 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["[Parça 3] Tamamlandı! Kaydedilen satır: 7200 -> dataset_v2_parts/meta_part_3.csv\n"]}],"source":["import itertools\n","import json\n","import shutil\n","import pandas as pd\n","from pathlib import Path\n","from tqdm.auto import tqdm\n","\n","# --- PARÇALI ÜRETİM AYARLARI (N_PER_COND = 50 -> Toplam 25.200 Örnek) ---\n","PART_ID = 3  # 1. çalıştırmada 1, 2. çalıştırmada 2, 3. çalıştırmada 3 yapın\n","\n","SNR_PARTS = {\n","    1: [-5, 0, 5],    # 3 SNR * 36 koşul * 50 * 2 = 10.800 örnek\n","    2: [10, 15],      # 2 SNR * 36 koşul * 50 * 2 =  7.200 örnek\n","    3: [20, 25],      # 2 SNR * 36 koşul * 50 * 2 =  7.200 örnek\n","}\n","\n","SNR_LEVELS   = SNR_PARTS[PART_ID]\n","ATTACK_TYPES = [\"replay\", \"low_power\", \"multi_ghost\", \"colocated\"]\n","CLUTTER      = [\"none\", \"low\", \"high\"]\n","N_TARGETS    = [1, 2, 3]\n","N_PER_COND   = 50\n","\n","out_dir = Path(\"dataset_v2\")\n","parts_dir = Path(\"dataset_v2_parts\")\n","parts_dir.mkdir(parents=True, exist_ok=True)\n","\n","# İlk parçaya başlamadan önce eski 1008'lik deneme klasörünü temizle\n","if PART_ID == 1 and out_dir.exists():\n","    shutil.rmtree(out_dir)\n","\n","(out_dir / \"attack\").mkdir(parents=True, exist_ok=True)\n","(out_dir / \"safe\").mkdir(parents=True, exist_ok=True)\n","\n","# N_PER_COND = 50 için: 0..39 -> train (40), 40..44 -> val (5), 45..49 -> test (5)\n","def get_split(rep_idx: int) -> str:\n","    if rep_idx < int(N_PER_COND * 0.8):\n","        return \"train\"\n","    elif rep_idx < int(N_PER_COND * 0.9):\n","        return \"val\"\n","    else:\n","        return \"test\"\n","\n","conditions = list(itertools.product(SNR_LEVELS, ATTACK_TYPES, CLUTTER, N_TARGETS))\n","part_records = []\n","\n","print(f\"[Parça {PART_ID}] SNR={SNR_LEVELS} | {len(conditions)} koşul | {len(conditions) * N_PER_COND * 2} örnek üretiliyor...\")\n","\n","for snr, atype, clut, ntgt in tqdm(conditions, desc=f\"Parça {PART_ID} İlerlemesi\"):\n","    for rep in range(N_PER_COND):\n","        split_name = get_split(rep)\n","\n","        # 1. SALDIRI ÖRNEĞİ (label = 1)\n","        seed_att = hash((\"attack\", snr, atype, clut, ntgt, rep)) % (2**31)\n","        rdm_att, meta_att = simulate_scenario(\n","            snr_db=snr,\n","            attack_type=atype,\n","            n_real_targets=ntgt,\n","            clutter_level=clut,\n","            seed=seed_att\n","        )\n","        sid_att = f\"{atype}_snr{snr:+d}_cl{clut}_t{ntgt}_r{rep:03d}\"\n","        npy_rel_att = f\"attack/{sid_att}.npy\"\n","\n","        meta_att[\"sample_id\"] = sid_att\n","        meta_att[\"split\"] = split_name\n","        meta_att[\"file_path\"] = npy_rel_att\n","\n","        np.save(out_dir / npy_rel_att, rdm_att)\n","        with open(out_dir / \"attack\" / f\"{sid_att}.json\", \"w\", encoding=\"utf-8\") as f:\n","            json.dump(meta_att, f, indent=2)\n","        part_records.append(meta_att)\n","\n","        # 2. GÜVENLİ ÖRNEK (label = 0)\n","        seed_safe = hash((\"safe\", snr, atype, clut, ntgt, rep)) % (2**31)\n","        rdm_safe, meta_safe = simulate_scenario(\n","            snr_db=snr,\n","            attack_type=None,\n","            n_real_targets=ntgt,\n","            clutter_level=clut,\n","            seed=seed_safe\n","        )\n","        sid_safe = f\"safe_{atype}_snr{snr:+d}_cl{clut}_t{ntgt}_r{rep:03d}\"\n","        npy_rel_safe = f\"safe/{sid_safe}.npy\"\n","\n","        meta_safe[\"sample_id\"] = sid_safe\n","        meta_safe[\"split\"] = split_name\n","        meta_safe[\"file_path\"] = npy_rel_safe\n","\n","        np.save(out_dir / npy_rel_safe, rdm_safe)\n","        with open(out_dir / \"safe\" / f\"{sid_safe}.json\", \"w\", encoding=\"utf-8\") as f:\n","            json.dump(meta_safe, f, indent=2)\n","        part_records.append(meta_safe)\n","\n","part_csv = parts_dir / f\"meta_part_{PART_ID}.csv\"\n","pd.DataFrame(part_records).to_csv(part_csv, index=False)\n","print(f\"[Parça {PART_ID}] Tamamlandı! Kaydedilen satır: {len(part_records)} -> {part_csv}\")"]},{"cell_type":"code","execution_count":5,"id":"d8981c27","metadata":{"execution":{"iopub.execute_input":"2026-11-22T01:01:55.779567Z","iopub.status.busy":"2026-11-22T01:01:55.778877Z","iopub.status.idle":"2026-11-22T01:01:55.883072Z","shell.execute_reply":"2026-11-22T01:01:55.882286Z"},"papermill":{"duration":0.138423,"end_time":"2026-11-22T01:01:55.884556+00:00","exception":false,"start_time":"2026-11-22T01:01:55.746133+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Birleştirme tamamlandı! Toplam örnek: 7200\n","Sınıf dağılımı:\n"," label\n","1    3600\n","0    3600\n","Name: count, dtype: int64\n","\n","Split dağılımı:\n"," split\n","train    5760\n","val       720\n","test      720\n","Name: count, dtype: int64\n"]}],"source":["import pandas as pd\n","from pathlib import Path\n","\n","out_dir = Path(\"dataset_v2\")\n","part_