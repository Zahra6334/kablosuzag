Z","iopub.status.idle":"2026-11-07T22:32:41.370122Z","shell.execute_reply.started":"2026-11-07T22:32:41.364461Z","shell.execute_reply":"2026-11-07T22:32:41.369369Z"}},"outputs":[],"execution_count":17},{"cell_type":"code","source":"import numpy as np\nimport matplotlib.pyplot as plt\n\n# --- 1. ISAC OFDM SİSTEM PARAMETRELERİ ---\nN = 64              # Alt taşıyıcı sayısı (Subcarriers)\nCP = 32            # Cyclic Prefix (CP) uzunluğu (Kanal gecikmelerine karşı koruma)\nnum_symbols = 8192  # Gönderilecek toplam OFDM sembolü sayısı\n\nprint(\"--- ISAC OFDM Verici (Transmitter) Başlatıldı ---\")\n\n# --- 2. HABERLEŞME VERİSİ ÜRETİMİ (QPSK Modülasyonu) ---\n# QPSK (Quadrature Phase Shift Keying) sembol uzayı oluşturuluyor\n# 4 farklı faz durumu: +1+1j, +1-1j, -1+1j, -1-1j (Normalize edilmiş)\nqpsk_constellation = np.array([1+1j, 1-1j, -1+1j, -1-1j]) / np.sqrt(2)\n\n# N alt taşıyıcı ve num_symbols kadar rastgele haberleşme sembolü matrisi\ndata_symbols = np.random.choice(qpsk_constellation, (N, num_symbols))\nprint(f\"1. Frekans Ortamı Veri Matrisi Boyutu: {data_symbols.shape}\")\n\n# --- 3. IFFT İŞLEMİ (Frekans Ortamından Zaman Ortamına Geçiş) ---\n# Eksen boyunca ters hızlı fourier dönüşümü uygulanır\nifft_data = np.fft.ifft(data_symbols, axis=0)\n\n# --- 4. CYCLIC PREFIX (CP) EKLENMESİ ---\n# Her sembolün son kısmından CP uzunluğu kadar bölüm alınıp başa eklenir (Multipath sönümlemesini önlemek için)\ncp_data = ifft_data[-CP:, :]\nofdm_tx_matrix = np.vstack((cp_data, ifft_data))\nprint(f\"2. CP Eklenmiş Zaman Ortamı Matrisi Boyutu (N+CP): {ofdm_tx_matrix.shape}\")\n\n# --- 5. SİNYALİN SERİ HALE GETİRİLMESİ (Antenden Gönderim İçin) ---\n# Sütun bazlı (Fortran-style 'F') düzleştirme işlemi\ntx_signal_serial = ofdm_tx_matrix.flatten('F')\nprint(f\"3. Antenden Gönderilecek Seri ISAC Sinyali Boyutu: {tx_signal_serial.shape}\")\n\n# --- GÖRSELLEŞTİRME ---\n# Üretilen kompleks sinyalin ilk 200 örneğinin (Gerçek ve Sanal kısımları) çizdirilmesi\nplt.figure(figsize=(12, 4))\nplt.plot(np.real(tx_signal_serial[:200]), label='Gerçek (Real) Kısım', color='blue', alpha=0.7)\nplt.plot(np.imag(tx_signal_serial[:200]), label='Sanal (Imaginary) Kısım', color='red', alpha=0.7)\nplt.title('Üretilen Zaman Ortamı OFDM-ISAC Sinyali (İlk 200 Örnek)')\nplt.xlabel('Örnek (Sample) İndeksi')\nplt.ylabel('Genlik (Amplitude)')\nplt.legend()\nplt.grid(True)\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T22:32:41.371977Z","iopub.execute_input":"2026-11-07T22:32:41.372759Z","iopub.status.idle":"2026-11-07T22:32:41.585558Z","shell.execute_reply.started":"2026-11-07T22:32:41.372721Z","shell.execute_reply":"2026-11-07T22:32:41.584928Z"}},"outputs":[{"name":"stdout","text":"--- ISAC OFDM Verici (Transmitter) Başlatıldı ---\n1. Frekans Ortamı Veri Matrisi Boyutu: (64, 8192)\n2. CP Eklenmiş Zaman Ortamı Matrisi Boyutu (N+CP): (96, 8192)\n3. Antenden Gönderilecek Seri ISAC Sinyali Boyutu: (786432,)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x400 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":18},{"cell_type":"markdown","source":"Gönderdiğimiz sinyal bir Gerçek Hedefe çarpıp geri dönecek, aynı zamanda araya giren bir Saldırgan (Spoofer) sinyali kopyalayıp içine yapay bir gecikme ve hız manipülasyonu ekleyerek ortama sahte bir yankı (Ghost Target) basacaktır. Ortama aynı zamanda AWGN (Gürültü) eklenecektir.\n","metadata":{}},{"cell_type":"code","source":"import numpy as np\nimport matplotlib.pyplot as plt\n\n# --- 1. SİSTEM VE FİZİKSEL ORTAM PARAMETRELERİ ---\nfc = 5e9          # Taşıyıcı Frekans (Carrier Frequency): 5 GHz\nc = 3e8           # Işık hızı: 3x10^8 m/s\nB = 30e6          # Bant Genişliği: 30 MHz \nfs = B            # Örnekleme frekansı \nTs = 1 / fs       # Örnekleme zamanı\n\n# Zaman vektörü (Bir önceki hücreden tx_signal_serial verisi kullanılıyor)\nt = np.arange(len(tx_signal_serial)) * Ts  \n\n# --- 2. YANKI (ECHO) ÜRETİM FONKSİYONU ---\ndef generate_echo(tx_signal, distance, speed, attenuation=1.0):\n    # Gecikme (Delay / Menzil) hesabı (Gidiş-Dönüş)\n    tau = 2 * distance / c\n    delay_samples = int(tau * fs)\n    \n    # Sinyali geciktir (Zaman kaydırması)\n    delayed_signal = np.roll(tx_signal, delay_samples)\n    delayed_signal[:delay_samples] = 0  # Başlangıçtaki kayan nedensellik dışı kısımları sıfırla\n    \n    # Doppler Kayması (Doppler Shift / Hız) hesabı\n    fd = 2 * speed * fc / c\n    doppler_phase = np.exp(1j * 2 * np.pi * fd * t)\n    \n    # Faz kaymalı ve gecikmeli yankı sinyali\n    return attenuation * delayed_signal * doppler_phase\n\nprint(\"--- Adım 2: Fiziksel Kanal ve Saldırı Modellemesi ---\")\n\n# --- 3. GERÇEK HEDEF (TRUE TARGET) MODELLEMESİ ---\nd_true = 50.0      # Gerçek araç menzili: 50 metre\nv_true = 15.0      # Gerçek araç hızı: 15 m/s (~54 km/h)\ntrue_echo = generate_echo(tx_signal_serial, d_true, v_true, attenuation=0.8)\nprint(f\"Gerçek Hedef Yankısı Üretildi: {d_true}m uzaklık, {v_true}m/s hız.\")\n\n# --- 4. SALDIRGAN VE SAHTE HEDEF (GHOST TARGET) MODELLEMESİ ---\n# Saldırgan sinyali kopyalar ve manipüle ederek aslında ortamda olmayan \n# 80 metre uzaklıkta ve 25 m/s hızla yaklaşan sahte bir araç yaratır.\nd_ghost = 80.0     \nv_ghost = 25.0     \nghost_echo = generate_echo(tx_signal_serial, d_ghost, v_ghost, attenuation=0.9)\nprint(f\"Sahte Hedef Yankısı (Spoofed) Üretildi: {d_ghost}m uzaklık, {v_ghost}m/s hız.\")\n\n# --- 5. ALICIYA (RX) ULAŞAN TOPLAM SİNYAL VE GÜRÜLTÜ (AWGN) ---\n# Ortamdaki gerçek ve sahte yankıların birleşimi\nrx_clean = true_echo + ghost_echo\n\n# AWGN (Beyaz Gauss Gürültüsü) eklenmesi\nSNR_dB = 15  # Sinyal Gürültü Oranı\nsnr_linear = 10**(SNR_dB / 10)\nsignal_power = np.mean(np.abs(rx_clean)**2)\nnoise_power = signal_power / snr_linear\nnoise = np.sqrt(noise_power/2) * (np.random.randn(len(rx_clean)) + 1j * np.random.randn(len(rx_clean)))\n\nrx_signal = rx_clean + noise\nprint(f\"Alıcıya Ulaşan Toplam Sinyal Boyutu (Gerçek + Sahte + Gürültü): {rx_signal.shape}\")\n\n# --- GÖRSELLEŞTİRME ---\nplt.figure(figsize=(12, 5))\nplt.plot(np.abs(rx_clean[:600]), label='Gürültüsüz Yankılar (Gerçek+Sahte)', color='black', linewidth=2)\nplt.plot(np.abs(rx_signal[:600]), label='Gürültülü Alınan Sinyal (Rx)', color='red', alpha=0.6)\nplt.title('Alıcıya (RX) Ulaşan Gecikmeli ve Doppler Kaymalı Toplam Sinyal')\nplt.xlabel('Örnek (Sample) İndeksi')\nplt.ylabel('Genlik (Amplitude)')\nplt.legend()\nplt.grid(True)\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T22:32:41.586554Z","iopub.execute_input":"2026-11-07T22:32:41.586933Z","iopub.status.idle":"2026-11-07T22:32:41.947448Z","shell.execute_reply.started":"2026-11-07T22:32:41.586911Z","shell.execute_reply":"2026-11-07T22:32:41.946645Z"}},"outputs":[{"name":"stdout","text":"--- Adım 2: Fiziksel Kanal ve Saldırı Modellemesi ---\nGerçek Hedef Yankısı Üretildi: 50.0m uzaklık, 15.0m/s hız.\nSahte Hedef Yankısı (Spoofed) Üretildi: 80.0m uzaklık, 25.0m/s hız.\nAlıcıya Ulaşan Toplam Sinyal Boyutu (Gerçek + Sahte + Gürültü): (786432,)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x500 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":19},{"cell_type":"markdown","source":"Adım 3'e geçiyoruz. Bu adımda, alıcıya ulaşan bu karmaşık 1 boyutlu sinyali matematiksel olarak işleyerek baz istasyonunun radar ekranını (Menzil-Doppler Haritası) oluşturacağız.","metadata":{}},{"cell_type":"code","source":"import numpy as np\nimport matplotlib.pyplot as plt\nfrom mpl_toolkits.mplot3d import Axes3D\n\nprint(\"--- Adım 3: Matched Filter Tabanlı 2D-FFT ve RDM Üretimi ---\")\n\n# 1. Alınan sinyali (rx_signal) ve Gönderilen referans sinyali (tx_signal_serial) matrise çevir\nrx_matrix = rx_signal.reshape((N + CP, num_symbols), order='F')\ntx_matrix = tx_signal_serial.reshape((N + CP, num_symbols), order='F')\n\n# 2. Cyclic Prefix (CP) kısımlarını at\nrx_data_time = rx_matrix[CP:, :]\ntx_data_time = tx_matrix[CP:, :]\n\n# 3. Her iki sinyali de frekans ortamına geçir (Fast-time FFT)\nrx_freq = np.fft.fft(rx_data_time, axis=0)\ntx_freq = np.fft.fft(tx_data_time, axis=0)\n\n# 4. MATCHED FILTER (Bölme yerine Eşlenik Çarpımı)\n# Bu işlem haberleşme verisini temizler ve fazı mükemmel korur\nradar_matrix = rx_freq * np.conj(tx_freq)\n\n# 5. 2D-FFT İŞLEMİ\n# Menzil (Range) tespiti için IFFT\nrange_matrix = np.fft.ifft(radar_matrix, axis=0)\n\n# Hız (Doppler) tespiti için semboller boyunca FFT\nrange_doppler_map = np.fft.fft(range_matrix, axis=1)\n\n# Doppler eksenini merkeze kaydır\nrange_doppler_map = np.fft.fftshift(range_doppler_map, axes=1)\n\n# Haritayı desibel (dB) cinsine çevir\nrdm_power_db = 20 * np.log10(np.abs(range_doppler_map) + 1e-10)\n\n# --- EKSEN HESAPLAMALARI ---\ndelta_r = c / (2 * B)\nrange_axis = np.arange(N) * delta_r\n\nT_sym = (N + CP) * Ts\ndelta_v = c / (2 * fc * num_symbols * T_sym)\ndoppler_axis = (np.arange(num_symbols) - num_symbols/2) * delta_v\n\n# --- GÖRSELLEŞTİRME ---\nX_grid, Y_grid = np.meshgrid(doppler_axis, range_axis)\n\nfig = plt.figure(figsize=(14, 6))\n\n# 3D Yüzey Çizimi\nax1 = fig.add_subplot(121, projection='3d')\nsurf = ax1.plot_surface(X_grid, Y_grid, rdm_power_db, cmap='jet')\nax1.set_title('3D Menzil-Doppler Haritası')\n\n# labelpad ile yazıları eksenden uzaklaştırıyoruz\nax1.set_xlabel('Hız (m/s)', labelpad=10)\nax1.set_ylabel('Menzil (m)', labelpad=10)\nax1.set_zlabel('Güç (dB)', labelpad=10)\nax1.set_ylim(0, 150)\nax1.set_xlim(-50, 50)\nax1.view_init(elev=30, azim=45) \n\n# tick_params(pad=...) ile sayıları grafiğe yapışmaktan kurtarıyoruz\nax1.tick_params(axis='x', pad=5)\nax1.tick_params(axis='y', pad=5)\nax1.tick_params(axis='z', pad=5)\n\n# 3D kamerayı hafifçe uzaklaştırarak sayıların kenardan kesilmesini engelliyoruz\nax1.dist = 20\n\n# 2D Isı Haritası\nax2 = fig.add_subplot(122)\ncax = ax2.pcolormesh(X_grid, Y_grid, rdm_power_db, shading='auto', cmap='jet')\nax2.set_title('2D Radar Ekranı')\nax2.set_xlabel('Hız (m/s)')\nax2.set_ylabel('Menzil (m)')\nax2.set_ylim(0, 150)\nax2.set_xlim(-50, 50)\nfig.colorbar(cax, ax=ax2, label='Güç (dB)')\n\n# Ekstra uzaklaştırma iptal edildi, varsayılan sıkı düzen kullanılıyor\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T22:32:41.949151Z","iopub.execute_input":"2026-11-07T22:32:41.949466Z","iopub.status.idle":"2026-11-07T22:32:43.136984Z","shell.execute_reply.started":"2026-11-07T22:32:41.949445Z","shell.execute_reply":"2026-11-07T22:32:43.135999Z"}},"outputs":[{"name":"stdout","text":"--- Adım 3: Matched Filter Tabanlı 2D-FFT ve RDM Üretimi ---\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1400x600 with 3 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":20},{"cell_type":"markdown","source":"Adım 4: Yapay Zeka İçin Veri Seti (Dataset) Oluşturma\nBu adımda, oluşturduğumuz bu radar sistemini bir \"for döngüsü\" içine alacağız.\n\nEtiket 0 (Safe / Güvenli): Ortamda sadece rastgele menzil ve hızda gerçek hedefler olacak.\n\nEtiket 1 (Attacked / Saldırı Altında): Ortama bir de spoofer (saldırgan) dahil olacak ve sahte yankı (ghost target) ekleyecek.","metadata":{}},{"cell_type":"code","source":"import numpy as np\nimport os\nfrom tqdm import tqdm # İlerleme çubuğu için\n\nprint(\"--- Adım 4: Yapay Zeka İçin Veri Seti Üretimi Başlıyor ---\")\nnp.random.seed(42) # Sadece bu kalacak\n\n# Veri setini kaydedeceğimiz klasörleri oluşturalım\nos.makedirs('ISAC_Dataset/0_Safe', exist_ok=True)\nos.makedirs('ISAC_Dataset/1_Attacked', exist_ok=True)\n\n# Makine öğrenmesi modeli çok büyük boyutlu (64x8192) veriyi işlerken yorulmasın diye\n# Doppler ekseninde sadece hedeflerin olabileceği orta kısmı keseceğiz (Crop işlemi)\ncrop_size = 64 # Radar ekranından 64x64'lük bir kare keseceğiz\n\n# Hızlı üretim için veri seti boyutunu şimdilik ufak tutalım (Makale için bu sayılar 1000'e çıkarılabilir)\nnum_samples_per_class = 1000\n\ndef generate_rdm_sample(is_attacked):\n    # 1. Her senaryoda yepyeni bir OFDM sinyali (Haberleşme verisi) üret\n    data_syms = np.random.choice(qpsk_constellation, (N, num_symbols))\n    tx_freq = data_syms\n    ifft_data = np.fft.ifft(data_syms, axis=0)\n    tx_time = np.vstack((ifft_data[-CP:, :], ifft_data)).flatten('F')\n    \n    # 2. Rastgele bir GERÇEK HEDEF oluştur\n    # Menzil: 20 ile 100 metre arası, Hız: 5 ile 30 m/s arası\n    d_true = np.random.uniform(20, 100)\n    v_true = np.random.uniform(5, 30)\n    rx_clean = generate_echo(tx_time, d_true, v_true, attenuation=0.8)\n    \n    # 3. Eğer saldırı durumu (is_attacked == True) ise SAHTE HEDEF ekle\n    if is_attacked:\n        d_ghost = np.random.uniform(30, 120)\n        v_ghost = np.random.uniform(10, 40)\n        ghost_echo = generate_echo(tx_time, d_ghost, v_ghost, attenuation=0.9)\n        rx_clean += ghost_echo\n        \n    # 4. Gürültü (AWGN) ekle (Rastgele SNR: 10 ile 20 dB arası)\n    snr = np.random.uniform(10, 20)\n    snr_linear = 10**(snr / 10)\n    signal_power = np.mean(np.abs(rx_clean)**2)\n    noise_power = signal_power / snr_linear\n    noise = np.sqrt(noise_power/2) * (np.random.randn(len(rx_clean)) + 1j * np.random.randn(len(rx_clean)))\n    rx_signal = rx_clean + noise\n    \n    # 5. MATCHED FILTER VE 2D-FFT İŞLEMİ (Radar Ekranı)\n    rx_matrix = rx_signal.reshape((N + CP, num_symbols), order='F')[CP:, :]\n    rx_freq = np.fft.fft(rx_matrix, axis=0)\n    \n    radar_matrix = rx_freq * np.conj(tx_freq)\n    range_matrix = np.fft.ifft(radar_matrix, axis=0)\n    rdm = np.fft.fftshift(np.fft.fft(range_matrix, axis=1), axes=1)\n    \n    rdm_db = 20 * np.log10(np.abs(rdm) + 1e-10)\n    \n    # 6. VERİYİ KÜÇÜLTME (Crop) - Sadece merkez bölgeyi al\n    center = num_symbols // 2\n    cropped_rdm = rdm_db[:, center - (crop_size//2) : center + (crop_size//2)]\n    \n    # Derin Öğrenme için değerleri 0 ile 1 arasına normalize et\n    cropped_rdm = (cropped_rdm - np.min(cropped_rdm)) / (np.max(cropped_rdm) - np.min(cropped_rdm))\n    \n    return cropped_rdm\n\n# --- DÖNGÜ BAŞLIYOR ---\nprint(\"Saldırısız (Güvenli) Senaryolar Üretiliyor...\")\nfor i in tqdm(range(num_samples_per_class)):\n    rdm = generate_rdm_sample(is_attacked=False)\n    np.save(f'ISAC_Dataset/0_Safe/sample_{i}.npy', rdm)\n\nprint(\"Saldırılı (Ghost Target) Senaryolar Üretiliyor...\")\nfor i in tqdm(range(num_samples_per_class)):\n    rdm = generate_rdm_sample(is_attacked=True)\n    np.save(f'ISAC_Dataset/1_Attacked/sample_{i}.npy', rdm)\n\nprint(f\"Toplam {num_samples_per_class * 2} adet (.npy) formatında RDM verisi başarıyla diske kaydedildi!\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T22:32:43.138243Z","iopub.execute_input":"2026-11-07T22:32:43.138476Z","iopub.status.idle":"2026-11-07T22:37:59.114896Z","shell.execute_reply.started":"2026-11-07T22:32:43.138455Z","shell.execute_reply":"2026-11-07T22:37:59.114199Z"}},"outputs":[{"name":"stdout","text":"--- Adım 4: Yapay Zeka İçin Veri Seti Üretimi Başlıyor ---\nSaldırısız (Güvenli) Senaryolar Üretiliyor...\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 1000/1000 [02:20<00:00,  7.11it/s]\n","output_type":"stream"},{"name":"stdout","text":"Saldırılı (Ghost Target) Senaryolar Üretiliyor...\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 1000/1000 [02:55<00:00,  5.71it/s]","output_type":"stream"},{"name":"stdout","text":"Toplam 2000 adet (.npy) formatında RDM verisi başarıyla diske kaydedildi!\n","output_type":"stream"},{"name":"stderr","text":"\n","output_type":"stream"}],"execution_count":21},{"cell_type":"code","source":"import numpy as np\nimport os\nimport matplotlib.pyplot as plt\nfrom sklearn.model_selection import train_test_split\nimport tensorflow as tf\nfrom tensorflow.keras.models import Sequential\nfrom tensorflow.keras.layers import Conv2D, MaxPooling2D, Flatten, Dense, Dropout\nfrom sklearn.metrics import classification_report, confusion_matrix\nimport sea