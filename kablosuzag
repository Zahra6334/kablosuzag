{"cells":[{"cell_type":"code","execution_count":1,"id":"869ad7ce","metadata":{"execution":{"iopub.execute_input":"2026-11-21T22:40:31.251964Z","iopub.status.busy":"2026-11-21T22:40:31.251543Z","iopub.status.idle":"2026-11-21T22:40:32.765504Z","shell.execute_reply":"2026-11-21T22:40:32.764601Z"},"papermill":{"duration":1.520631,"end_time":"2026-11-21T22:40:32.768958+00:00","exception":false,"start_time":"2026-11-21T22:40:31.248327+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1600x400 with 4 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["Birim testleri ve 4 saldırı tipi doğrulaması başarıyla tamamlandı!\n"]}],"source":["import numpy as np\n","import matplotlib.pyplot as plt\n","\n","# --- SİSTEM SABİTLERİ (Fiziksel Katman Parametreleri) ---\n","C = 3e8                   # Işık hızı (m/s)\n","FC = 5e9                  # Taşıyıcı frekans: 5 GHz\n","BW = 30e6                 # Bant genişliği: 30 MHz\n","N_SUBCARRIERS = 64        # Alt taşıyıcı sayısı (N)\n","CP_LEN = 32               # Cyclic Prefix uzunluğu (160m güvenli menzil)\n","NUM_SYMBOLS = 8192        # Çerçeve başına OFDM sembolü\n","CROP_SIZE = 64            # Çıktı RDM matris boyutu (64x64)\n","\n","DELTA_F = BW / N_SUBCARRIERS\n","T_SYM = (N_SUBCARRIERS + CP_LEN) / BW\n","QPSK_CONST = np.array([1+1j, 1-1j, -1+1j, -1-1j]) / np.sqrt(2)\n","\n","def _generate_echo(tx_time, distance_m, velocity_ms, attenuation):\n","    \"\"\"Belirli bir mesafe ve hıza sahip hedefin kanal gecikmesi ve Doppler kaymasını uygular.\"\"\"\n","    delay_sec = 2 * distance_m / C\n","    delay_samples = int(np.round(delay_sec * BW))\n","    \n","    fd = 2 * velocity_ms * FC / C\n","    t_axis = np.arange(len(tx_time)) / BW\n","    doppler_shift = np.exp(1j * 2 * np.pi * fd * t_axis)\n","    \n","    delayed_sig = np.roll(tx_time, delay_samples)\n","    delayed_sig[:delay_samples] = 0\n","    return attenuation * delayed_sig * doppler_shift\n","\n","def simulate_scenario(\n","    snr_db: float,\n","    attack_type: str = None,      # None (güvenli) | \"replay\" | \"low_power\" | \"multi_ghost\" | \"colocated\"\n","    n_real_targets: int = 1,      # 1, 2 veya 3\n","    clutter_level: str = \"none\",  # \"none\" | \"low\" | \"high\"\n","    spoofer_power: float = None,\n","    seed: int = None\n",") -> tuple[np.ndarray, dict]:\n","    \"\"\"\n","    Rehberdeki 252 koşullu ISAC-RDM Benchmark mimarisine uygun tek bir senaryo ve metadata üretir.\n","    \"\"\"\n","    if seed is not None:\n","        np.random.seed(seed)\n","        \n","    # 1. OFDM Sinyali Üretimi (Tx)\n","    data_syms = np.random.choice(QPSK_CONST, (N_SUBCARRIERS, NUM_SYMBOLS))\n","    ifft_data = np.fft.ifft(data_syms, axis=0)\n","    tx_time = np.vstack((ifft_data[-CP_LEN:, :], ifft_data)).flatten('F')\n","    \n","    rx_clean = np.zeros_like(tx_time, dtype=complex)\n","    \n","    # 2. Gerçek Hedeflerin Eklenmesi (1, 2 veya 3 hedef)\n","    real_ranges = []\n","    real_velocities = []\n","    for _ in range(n_real_targets):\n","        r_true = float(np.round(np.random.uniform(20.0, 100.0), 2))\n","        v_true = float(np.round(np.random.uniform(5.0, 30.0), 2))\n","        att_true = float(np.random.uniform(0.7, 0.9))\n","        rx_clean += _generate_echo(tx_time, r_true, v_true, att_true)\n","        real_ranges.append(r_true)\n","        real_velocities.append(v_true)\n","        \n","    # 3. Saldırı Senaryosunun Uygulanması (Adım 2)\n","    is_attacked = 1 if attack_type is not None else 0\n","    n_fake_targets = 0\n","    fake_delta_ranges = []\n","    fake_delta_vels = []\n","    used_spoofer_power = 0.0\n","    \n","    if is_attacked:\n","        if attack_type == \"replay\":\n","            n_fake_targets = 1\n","            used_spoofer_power = spoofer_power if spoofer_power is not None else float(np.round(np.random.uniform(0.7, 1.2), 3))\n","            d_ghost = float(np.round(np.random.uniform(30.0, 120.0), 2))\n","            v_ghost = float(np.round(np.random.uniform(10.0, 40.0), 2))\n","            rx_clean += _generate_echo(tx_time, d_ghost, v_ghost, used_spoofer_power)\n","            fake_delta_ranges.append(d_ghost)\n","            fake_delta_vels.append(v_ghost)\n","            \n","        elif attack_type == \"low_power\":\n","            n_fake_targets = 1\n","            used_spoofer_power = spoofer_power if spoofer_power is not None else float(np.round(np.random.uniform(0.05, 0.25), 3))\n","            d_ghost = float(np.round(np.random.uniform(30.0, 120.0), 2))\n","            v_ghost = float(np.round(np.random.uniform(10.0, 40.0), 2))\n","            rx_clean += _generate_echo(tx_time, d_ghost, v_ghost, used_spoofer_power)\n","            fake_delta_ranges.append(d_ghost)\n","            fake_delta_vels.append(v_ghost)\n","            \n","        elif attack_type == \"multi_ghost\":\n","            n_fake_targets = int(np.random.randint(2, 4)) # 2 veya 3 sahte hedef\n","            used_spoofer_power = spoofer_power if spoofer_power is not None else float(np.round(np.random.uniform(0.6, 1.1), 3))\n","            for _ in range(n_fake_targets):\n","                d_ghost = float(np.round(np.random.uniform(25.0, 125.0), 2))\n","                v_ghost = float(np.round(np.random.uniform(5.0, 45.0), 2))\n","                rx_clean += _generate_echo(tx_time, d_ghost, v_ghost, used_spoofer_power)\n","                fake_delta_ranges.append(d_ghost)\n","                fake_delta_vels.append(v_ghost)\n","                \n","        elif attack_type == \"colocated\":\n","            n_fake_targets = 1\n","            used_spoofer_power = spoofer_power if spoofer_power is not None else float(np.round(np.random.uniform(0.7, 1.0), 3))\n","            # İlk gerçek hedefi referans alarak çok yakınına (1-5 m, 0.5-3 m/s) yerleştir\n","            ref_r = real_ranges[0]\n","            ref_v = real_velocities[0]\n","            delta_r = float(np.round(np.random.uniform(1.0, 5.0) * np.random.choice([-1, 1]), 2))\n","            delta_v = float(np.round(np.random.uniform(0.5, 3.0) * np.random.choice([-1, 1]), 2))\n","            \n","            d_ghost = np.clip(ref_r + delta_r, 10.0, 140.0)\n","            v_ghost = np.clip(ref_v + delta_v, 1.0, 48.0)\n","            rx_clean += _generate_echo(tx_time, d_ghost, v_ghost, used_spoofer_power)\n","            fake_delta_ranges.append(round(abs(delta_r), 2))\n","            fake_delta_vels.append(round(abs(delta_v), 2))\n","        else:\n","            raise ValueError(f\"Geçersiz saldırı tipi: {attack_type}\")\n","\n","    # 4. AWGN Gürültüsü Ekleme\n","    snr_linear = 10 ** (snr_db / 10.0)\n","    signal_power = np.mean(np.abs(rx_clean) ** 2)\n","    noise_power = signal_power / snr_linear\n","    noise = np.sqrt(noise_power / 2.0) * (np.random.randn(len(rx_clean)) + 1j * np.random.randn(len(rx_clean)))\n","    rx_signal = rx_clean + noise\n","    \n","    # 5. Alıcı İşlemleri: Matched Filter & 2D-FFT (RDM Üretimi)\n","    rx_matrix = rx_signal.reshape((N_SUBCARRIERS + CP_LEN, NUM_SYMBOLS), order='F')[CP_LEN:, :]\n","    rx_freq = np.fft.fft(rx_matrix, axis=0)\n","    \n","    radar_matrix = rx_freq * np.conj(data_syms)\n","    range_matrix = np.fft.ifft(radar_matrix, axis=0)\n","    rdm = np.fft.fftshift(np.fft.fft(range_matrix, axis=1), axes=1)\n","    rdm_db = 20 * np.log10(np.abs(rdm) + 1e-10)\n","    \n","    # Merkez bölgeyi kırpma (64x64) ve [0, 1] aralığına normalizasyon\n","    center = NUM_SYMBOLS // 2\n","    cropped_rdm = rdm_db[:, center - (CROP_SIZE // 2) : center + (CROP_SIZE // 2)]\n","    cropped_rdm = (cropped_rdm - np.min(cropped_rdm)) / (np.max(cropped_rdm) - np.min(cropped_rdm) + 1e-12)\n","    \n","    # 6. Clutter (Ortam Karmaşası) Ekleme (Adım 3)\n","    clutter_sigma = {\"none\": 0.0, \"low\": 0.05, \"high\": 0.20}[clutter_level]\n","    if clutter_sigma > 0:\n","        clutter = np.random.rayleigh(clutter_sigma, cropped_rdm.shape)\n","        cropped_rdm = np.clip(cropped_rdm + clutter, 0.0, 1.0)\n","        \n","    rdm_final = cropped_rdm.astype(np.float32)\n","    \n","    # 7. Rehberdeki Tam Metadata Şeması (Bölüm 5.2)\n","    metadata = {\n","        \"label\": is_attacked,\n","        \"snr_db\": snr_db,\n","        \"attack_type\": attack_type,\n","        \"n_real_targets\": n_real_targets,\n","        \"n_fake_targets\": n_fake_targets,\n","        \"clutter_level\": clutter_level,\n","        \"spoofer_power\": used_spoofer_power if is_attacked else None,\n","        \"real_range_m\": real_ranges,\n","        \"real_velocity_ms\": real_velocities,\n","        \"fake_delta_range_m\": fake_delta_ranges,\n","        \"fake_delta_vel_ms\": fake_delta_vels,\n","        \"ofdm_subcarriers\": N_SUBCARRIERS,\n","        \"cyclic_prefix\": CP_LEN,\n","        \"carrier_freq_ghz\": FC / 1e9,\n","        \"bandwidth_mhz\": BW / 1e6,\n","        \"seed\": seed\n","    }\n","    \n","    return rdm_final, metadata\n","\n","# --- ADIM 1 & 6.2 DOĞRULAMA TESTİ (Görsel Kontrol) ---\n","fig, axes = plt.subplots(1, 4, figsize=(16, 4))\n","test_types = [\"replay\", \"low_power\", \"multi_ghost\", \"colocated\"]\n","\n","for ax, atype in zip(axes, test_types):\n","    rdm_sample, meta_sample = simulate_scenario(snr_db=20, attack_type=atype, n_real_targets=1, clutter_level=\"low\", seed=42)\n","    assert rdm_sample.shape == (64, 64) and rdm_sample.dtype == np.float32\n","    assert 0.0 <= rdm_sample.min() and rdm_sample.max() <= 1.0\n","    \n","    ax.imshow(rdm_sample, cmap='jet', aspect='auto')\n","    ax.set_title(f\"{atype}\\n(Fake: {meta_sample['n_fake_targets']}, P: {meta_sample['spoofer_power']})\")\n","    ax.axis('off')\n","\n","plt.tight_layout()\n","plt.show()\n","print(\"Birim testleri ve 4 saldırı tipi doğrulaması başarıyla tamamlandı!\")"]},{"cell_type":"code","execution_count":2,"id":"0642e6c5","metadata":{"execution":{"iopub.execute_input":"2026-11-21T22:40:32.77593Z","iopub.status.busy":"20